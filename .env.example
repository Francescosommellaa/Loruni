# L'avvio locale attuale non richiede variabili d'ambiente.
# Aggiungere soltanto i nomi delle variabili realmente necessarie, con valori vuoti.
# Non inserire credenziali, domini personali o valori reali.
# Le variabili NEXT_PUBLIC_* sono pubbliche nel browser e non possono contenere segreti.

# Opzionale: development (default), preview oppure production sul solo host pubblico.
# La selezione vale durante la build: non cambiarla soltanto dopo la build.
SITE_ENV=
# Opzionali: valori reali dal servizio; lasciare vuoti finché non configurati.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
