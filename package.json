{
  "name": "loruni",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "oxlint src scripts tests vite.config.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test tests/*.test.mjs",
    "inventory:report": "node scripts/framer/report.mjs",
    "tokens:generate": "node scripts/framer/tokens.mjs",
    "tokens:check": "node scripts/framer/tokens.mjs --check",
    "preview": "vite preview --host 127.0.0.1"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.13.1"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.86.0",
    "typescript": "6.0.3",
    "vite": "8.3.2"
  }
}
