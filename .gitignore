# Dependencies and Next.js generated output
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Build/tool output; source does not use these directories
dist/
.cache/
.eslintcache
/output/
.playwright-cli/

# Reports, logs and local temporary files
coverage/
reports/local/
logs/
*.log
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig

# Environment templates are shared; real values are local
.env*
!.env.example
!.env.*.example

# Private keys and local credentials; public exceptions require review
*.key
*.p12
*.pfx
*.jks
*.keystore
*.pem
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credentials*.json
service-account*.json
google-credentials*.json
firebase-admin*.json
*-credentials.local.json

# Personal editor/OS state; shared .vscode files remain visible
.idea/
*.swp
*.swo
*~
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# Codex shared config/hooks remain visible; local state is not shared
**/.codex/config.local.toml
**/.codex/hooks.local.json
**/.codex/cache/
**/.codex/sessions/
**/.codex/logs/
**/.codex/auth.json

# Existing local Impeccable mock output
**/.impeccable/mocks/

# impeccable-ignore-start
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
**/.impeccable/*.png
**/.impeccable/review/
**/.impeccable/questions/
**/.impeccable/live/server.json
**/.impeccable/live/sessions/
**/.impeccable/live/previews/
**/.impeccable/live/annotations/
**/.impeccable/live/cache/
**/.impeccable/live/manual-edit-apply-transaction.json
**/.impeccable/live/manual-edit-events.jsonl
**/.impeccable/live/manual-edit-evidence/
**/.impeccable/live/pending-manual-edits.json
**/.impeccable/live/deferred-svelte-component-accepts.json
**/.impeccable/live/*.png
# impeccable-ignore-end
